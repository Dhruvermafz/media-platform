# Copy this file to .env at the repo root before running docker compose.
# Full explanations of each variable live in migration.md section 2.

# --- API ---
NODE_ENV=development
PORT=3000
JWT_SECRET=dev-only-change-me-64-chars-minimum-in-production-xxxxxxxxxxxx
JWT_EXPIRES_IN=1h
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
ASSET_CACHE_TTL_SECONDS=30
# Comma-separated emails promoted to ADMIN on register/login (Operations page,
# user management). Leave empty to have no admins.
ADMIN_EMAILS=demo@example.com,admin@example.com
# Trash keeps deleted files this long before they are permanently purged.
TRASH_RETENTION_DAYS=30
# Uploads never confirmed as assets are deleted after this many hours.
ORPHAN_UPLOAD_TTL_HOURS=24
CLEANUP_ENABLED=true

# --- Database ---
POSTGRES_USER=media
POSTGRES_PASSWORD=media_dev_password
POSTGRES_DB=media_platform
DATABASE_URL=postgresql://media:media_dev_password@postgres:5432/media_platform

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO locally; same var names point at S3 in prod) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=media-platform
S3_FORCE_PATH_STYLE=true
# The address *browsers* use for presigned upload/download URLs. Inside
# docker-compose the API reaches MinIO as http://minio:9000, which a browser
# cannot resolve, so signed URLs must point at the published port instead.
# In production leave this unset (it defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_password
