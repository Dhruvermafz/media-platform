# Copy this file to .env at the repo root before running docker compose.
# Full explanations of each variable live in migration.md section 2.

# --- API ---
NODE_ENV=development
PORT=3000
JWT_SECRET=dev-only-change-me-64-chars-minimum-in-production-xxxxxxxxxxxx
JWT_EXPIRES_IN=1h
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
ASSET_CACHE_TTL_SECONDS=30

# --- Database ---
POSTGRES_USER=media
POSTGRES_PASSWORD=media_dev_password
POSTGRES_DB=media_platform
DATABASE_URL=postgresql://media:media_dev_password@postgres:5432/media_platform

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO locally; same var names point at S3 in prod) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=media-platform
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_password
